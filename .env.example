# Live season (server only)
WORM_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # Robinhood Chain, chain ID 4663
WORM_DATA_DIR=/srv/worm/data                            # where the season ledgers live; back it up

# Daily anchors on Robinhood Chain (only on the machine that sends them; never commit a real key)
ANCHOR_PRIVATE_KEY=

# Daily post from the WORM account (scripts/post-daily.ts; X API v2, OAuth 1.0a user keys)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
